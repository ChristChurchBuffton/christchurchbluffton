  "writePaths": ["/people/add", "/tags/assign"],
  "env": {
    "RESEND_API_KEY": "re_dummy_key",
    "TURNSTILE_SECRET_KEY": "dummy_secret",
    "TURNSTILE_SECRET_KEY_INVISIBLE": "dummy_secret_invisible",
    "SUPABASE_URL": "https://abcdefgh.supabase.co",
    "SUPABASE_SECRET_KEY": "dummy_service_key",
    "BREEZE_URL": "https://ccb-test.breezechms.com/api",
    "BREEZE_API_KEY": "dummy_breeze_key",
    "BREEZE_EMAIL_FIELD_ID": "111",
    "BREEZE_PHONE_FIELD_ID": "222",
    "BREEZE_TAG_CONTACT": "333",
    "BREEZE_TAG_STAYUPDATED": "444"
  },
