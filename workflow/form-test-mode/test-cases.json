    { "urlContains": "form_key=eq.newsletter", "method": "GET", "respond": [{ "recipients": ["newsletter-desk@ccb.example"] }] },
    { "urlContains": "/people/add",  "respond": { "id": "12345" } },
    { "urlContains": "/tags/assign", "respond": {} }
  ],
  "cases": [
    {
