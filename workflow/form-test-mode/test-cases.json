      "realRecipients": ["contact-desk@ccb.example", "office@ccb.example"],
      "writesExpected": 3
    },
    {
      "name": "Contact form - Prayer & Pastoral Care with follow-up (prayer team list + extra prayer_requests row)",
      "function": "../../src/netlify/functions/contact.js",
